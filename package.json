{
  "name": "beads-mcp",
  "version": "0.1.0",
  "description": "HTTP MCP server for shared Beads task tracking",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "prebuild": "npm run typecheck",
    "build": "vite build",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ci": "vitest run --reporter=json --outputFile=test-results.json",
    "bench": "LOG_LEVEL=error node --experimental-transform-types src/bench-latency.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "verify:skill-package": "node scripts/verify-skill-package.mjs",
    "test:beads": "BEADS_LIVE_TEST=1 vitest run src/beads.live.test.ts",
    "test:beads-http": "BD_SERVE_LIVE_TEST=1 vitest run src/beads-http.live.test.ts"
  },
  "keywords": [
    "mcp",
    "beads",
    "typescript",
    "agents"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.49.0",
    "concurrently": "^10.0.4",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/express": "^5.0.6",
    "effect": "^4.0.2",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "yaml": "^2.9.1"
  }
}
